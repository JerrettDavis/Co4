# Production only. co4 serve reads process environment; Compose loads this file.
# Force UTF-8 in all subprocesses on Windows
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
CO4_PUBLIC_URL=https://co4.example.org
CO4_DATABASE_URL=sqlite:////data/co4.db
CO4_DATA_KEY=REPLACE_WITH_OUTPUT_OF_co4_keygen
GITHUB_APP_ID=REPLACE_WITH_APP_ID
GITHUB_APP_SLUG=REPLACE_WITH_EXACT_APP_SLUG
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app_key
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_APP_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_APP_CLIENT_SECRET
# Only needed for compose.postgres.yaml:
POSTGRES_PASSWORD=REPLACE_WITH_A_SEPARATE_RANDOM_DATABASE_PASSWORD
